# Registration hooks for the ttnn.experimental.bposit_quire_matmul op against tt-metal 3548ed05
# (2026-06-05). Apply with: git apply targets/blackhole/tt-metal-integration.patch
# The programming examples are registered separately — see README.md in this directory.
diff --git a/ttnn/CMakeLists.txt b/ttnn/CMakeLists.txt
index 2bebcd00..212d81a1 100644
--- a/ttnn/CMakeLists.txt
+++ b/ttnn/CMakeLists.txt
@@ -252,6 +252,7 @@ target_link_libraries(
         TTNN::Ops::Experimental::Matmul
         TTNN::Ops::Experimental::PaddedSlice
         TTNN::Ops::Experimental::MinimalMatmul
+        TTNN::Ops::Experimental::BpositQuireMatmul
         TTNN::Ops::Experimental::DeepseekMoEPostCombineTilize
         TTNN::Ops::Experimental::DeepSeekPrefill::PostCombineReduce
         TTNN::Ops::Experimental::DeepSeek::MoE::MoEGateMM
@@ -324,6 +325,17 @@ if(WITH_PYTHON_BINDINGS)
     add_library(Metalium::TTNN ALIAS ttnn) # backwards compatibility. FIXME: remove
     TT_ENABLE_UNITY_BUILD(ttnn)
 
+    # pytensor.cpp (namespace ttnn::tensor) uses unqualified `experimental::...`
+    # that resolves via `using namespace tt::tt_metal`; it must NOT share a unity TU
+    # with any file that makes `ttnn::experimental` visible (e.g. an experimental op's
+    # nanobind header), or that lookup binds to ttnn::experimental and fails. Compile
+    # it standalone to keep it independent of experimental-op unity grouping.
+    set_source_files_properties(
+        cpp/ttnn-nanobind/pytensor.cpp
+        PROPERTIES
+            SKIP_UNITY_BUILD_INCLUSION ON
+    )
+
     set_target_properties(
         ttnn
         PROPERTIES
@@ -510,6 +522,7 @@ add_subdirectory(cpp/ttnn/operations/experimental/dropout)
 add_subdirectory(cpp/ttnn/operations/experimental/isin)
 add_subdirectory(cpp/ttnn/operations/experimental/matmul)
 add_subdirectory(cpp/ttnn/operations/experimental/minimal_matmul)
+add_subdirectory(cpp/ttnn/operations/experimental/bposit_quire_matmul)
 add_subdirectory(cpp/ttnn/operations/experimental/deepseek/moe/moe_gate_mm)
 add_subdirectory(cpp/ttnn/operations/experimental/deepseek/moe/deepseek_moe_gate)
 add_subdirectory(cpp/ttnn/operations/experimental/topk_router_gpt)
diff --git a/ttnn/cpp/ttnn/operations/experimental/experimental_nanobind.cpp b/ttnn/cpp/ttnn/operations/experimental/experimental_nanobind.cpp
